option('tests', type: 'boolean', value: true, description: 'Build/run ordinary process lifecycle tests')
option('vm_tests', type: 'boolean', value: false, description: 'Build static PID 1 fixtures and enable QEMU boot tests')
option('vm_kernel', type: 'string', value: '', description: 'Linux x86-64 kernel image for QEMU')
option('vm_busybox', type: 'string', value: '', description: 'Static BusyBox executable for the guest')
option('vm_qemu', type: 'string', value: 'qemu-system-x86_64', description: 'QEMU program for boot tests')
option('efi', type: 'boolean', value: false, description: 'Build native x86-64 EFI bootloader with GNU-EFI')
option('efi_include', type: 'string', value: '/usr/include/efi', description: 'GNU-EFI include directory')
option('efi_lib', type: 'string', value: '/usr/lib', description: 'GNU-EFI CRT, linker script and libraries directory')
option('efi_vm_tests', type: 'boolean', value: false, description: 'Boot Lillyboot under OVMF (requires efi and vm_tests)')
option('ovmf_code', type: 'string', value: '', description: 'OVMF_CODE firmware image')
option('ovmf_vars', type: 'string', value: '', description: 'Fresh OVMF_VARS template, copied per test')
option('efi_qemu', type: 'string', value: 'qemu-system-x86_64', description: 'QEMU program for UEFI boot tests')
