option('tests', type: 'boolean', value: true, description: 'Build/run ordinary process lifecycle tests')
option('vm_tests', type: 'boolean', value: false, description: 'Build static PID 1 fixtures and enable QEMU boot tests')
option('vm_kernel', type: 'string', value: '', description: 'Linux x86-64 kernel image for QEMU')
option('vm_busybox', type: 'string', value: '', description: 'Static BusyBox executable for the guest')
option('vm_qemu', type: 'string', value: 'qemu-system-x86_64', description: 'QEMU program for boot tests')
option('efi', type: 'boolean', value: false, description: 'Build native x86-64 EFI bootloader with GNU-EFI')
option('efi_include', type: 'string', value: '/usr/include/efi', description: 'GNU-EFI include directory')
option('efi_lib', type: 'string', value: '/usr/lib', description: 'GNU-EFI CRT, linker script and libraries directory')
option('efi_vm_tests', type: 'boolean', value: false, description: 'Boot Lillyboot under OVMF (requires efi and vm_tests)')
option('ovmf_code', type: 'string', value: '', description: 'OVMF_CODE firmware image')
option('ovmf_vars', type: 'string', value: '', description: 'Fresh OVMF_VARS template, copied per test')
option('efi_qemu', type: 'string', value: 'qemu-system-x86_64', description: 'QEMU program for UEFI boot tests')
option('udev_daemon', type: 'string', value: '/usr/bin/udevd', description: 'Absolute foreground udev provider executable (eudev or systemd-udevd)')
option('udev_admin', type: 'string', value: '/usr/bin/udevadm', description: 'Absolute matching provider udevadm executable')
option('pam', type: 'feature', value: 'auto', description: 'Build pam_lilly session integration')
option('pam_module_dir', type: 'string', value: 'lib/security', description: 'PAM module installation directory relative to prefix, or absolute')
option('device_vm_tests', type: 'boolean', value: false, description: 'Test actual udev and PAM in a disposable QEMU guest (requires vm_tests and pam)')
option('vm_udevd', type: 'string', value: '', description: 'Trusted host provider daemon for the device VM fixture')
option('vm_udevadm', type: 'string', value: '', description: 'Trusted matching provider udevadm for the device VM fixture')
option('native_engines', type: 'boolean', value: false, description: 'Build standalone Lilly udev and login1 engines from tracked source trees')
option('engine_sources', type: 'string', value: '', description: 'Directory containing Lilly-vendored udev/logind source trees')
option('engine_jobs', type: 'integer', min: 1, value: 4, description: 'Parallel jobs per native engine build')
option('native_engine_vm_tests', type: 'boolean', value: false, description: 'Boot source-built native rule/login1 engines from an explicitly staged installation')
option('native_engine_stage', type: 'string', value: '', description: 'Staged native installation for native_engine_vm_tests')
