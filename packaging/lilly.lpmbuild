#!/bin/bash
# Experimental system manager. Installation does not switch the active init.
NAME="lilly"
VERSION="0.5.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Lilly PID 1 with standalone device/login1 engines and EFI bootloader"
URL="https://github.com/BobTheZombie/lilly"
LICENSE=("MIT" "LGPL-2.1-or-later" "GPL-2.0-or-later")
SOURCE=("https://github.com/BobTheZombie/lilly/archive/refs/heads/main.tar.gz")
SHA256SUMS=("SKIP") # Replace branch snapshot with a verified release before distribution.
PATCHES=()
REQUIRES=("glibc" "pam" "acl" "audit" "libcap" "libseccomp" "kmod" "util-linux-libs" "dbus" "polkit")
BUILD_REQUIRES=("gcc" "meson" "ninja" "python" "binutils" "pam" "acl" "audit" "libcap" "libseccomp" "kmod" "util-linux-libs" "gperf" "pkgconf" "patchelf")
if [ "$ARCH" = x86_64 ]; then BUILD_REQUIRES+=("gnu-efi"); fi
REQUIRES_PYTHON_DEPENDENCIES=("jinja2")
PROVIDES=("lilly" "servicectl" "lillyboot" "lilly-logd" "lilly-devices" "lilly-sessions" "lilly-udevadm" "lilly-loginctl" "lilly-inhibit" "lilly-hwdb" "lilly-udevd" "lilly-logind")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=("networkmanager" "openssh" "util-linux")
BUILD_OPTIONS=("@--stripping" "@--optimize=2")
prepare() {
    set -euxo pipefail
    if [ ! -d "$SRCROOT/$NAME-$VERSION" ] && [ -d "$SRCROOT/lilly-main" ]; then
        mv "$SRCROOT/lilly-main" "$SRCROOT/$NAME-$VERSION"
    fi
    cd "$SRCROOT/$NAME-$VERSION"
    test -f meson.build
    test -f src/lilly.c
    test -f vendor/udev/meson.build
    test -f vendor/logind/meson.build
}
build() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
    local efi=false
    if [ "$ARCH" = x86_64 ]; then efi=true; fi
    meson setup build --prefix=/usr --libdir=lib --libexecdir=/usr/libexec --sysconfdir=/etc \
        --buildtype=release --wrap-mode=nodownload -Dvm_tests=false -Dpam=enabled -Defi="$efi" \
        -Dnative_engines=true -Dengine_sources="$SRCROOT/$NAME-$VERSION/vendor" \
        -Dengine_jobs="${LPM_BUILD_JOBS:-4}"
    meson compile -C build -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
    meson test -C build --no-rebuild --print-errorlogs
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
    meson install -C build --no-rebuild --destdir "$pkgdir"
    test -x "$pkgdir/usr/bin/lilly"
    test -x "$pkgdir/usr/bin/servicectl"
    test -x "$pkgdir/usr/bin/lillyboot"
    test -x "$pkgdir/usr/bin/lilly-logd"
    if [ "$ARCH" = x86_64 ]; then test -s "$pkgdir/usr/lib/lilly/efi/lillybootx64.efi"; fi
    test -s "$pkgdir/usr/lib/security/pam_lilly.so"
    test -x "$pkgdir/usr/bin/lilly-devices"
    test -x "$pkgdir/usr/bin/lilly-sessions"
    test -x "$pkgdir/usr/lib/lilly/engines/lilly-udevd"
    test -x "$pkgdir/usr/lib/lilly/engines/lilly-logind"
    test -s "$pkgdir/usr/lib/security/pam_lilly_login.so"
    test ! -e "$pkgdir/sbin/init"
    test ! -e "$pkgdir/usr/bin/systemctl"
}
