[Unit]
Description=Example opt-in real-time workload (replace executable before use)
StartLimitBurst=3
StartLimitIntervalSec=30

[Service]
Type=simple
ExecStart=/usr/local/bin/my-realtime-worker
Restart=on-failure
RestartSec=1
CPUSchedulingPolicy=rr
CPUSchedulingPriority=10
CPUAffinity=0-1
LimitRTTIME=200000
TimeoutStartSec=10
TimeoutStopSec=5
